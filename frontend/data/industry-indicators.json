  "commonElements": [
    {
      "field": "Granularity",
      "details": "Monthly, quarterly, and yearly views are available."
    },
    {
      "field": "Period controls",
      "details": "Range view supports from/to periods; single-period view focuses the dashboard on one selected period."
    },
    {
      "field": "Operator filter",
      "details": "Operator selector supports all operators or a single selected operator when applicable."
    },
    {
      "field": "Trend modes",
      "details": "Absolute values, quarter-on-quarter, year-on-year, and index views are supported for range analysis."
    },
    {
      "field": "Data table toggle",
      "details": "Each chart can expose its underlying data table."
    },
    {
      "field": "KPI grid",
      "details": "The dashboard shows headline KPI cards from the visible charts in the active indicator section."
    },
    {
      "field": "CSV export",
      "details": "Exports visible chart data with dashboard, section, granularity, chart, unit, period, series, value, and source workbook."
    },
    {
      "field": "Workbook upload",
      "details": "Each dashboard includes an upload panel for replacing demo data with a live workbook dataset."
    },
    {
      "field": "Forecast panel",
      "details": "A forecast panel is available for the configured default metric and can switch to other chart metrics."
    },
    {
      "field": "Custom charts",
      "details": "When a workbook is active, users can create custom charts and add dashboard-visible custom chart sections."
    }
  ],
